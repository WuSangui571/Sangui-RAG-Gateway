# Infrastructure
# PostgreSQL and Redis are internal-only in the default Compose deployment.
# POSTGRES_PORT and REDIS_PORT are opt-in: they are only used when you include
# the explicit host-port override file (see README for the documented command).
POSTGRES_DB=sangui_rag_gateway
POSTGRES_USER=sangui
POSTGRES_PASSWORD=sangui_password
POSTGRES_PORT=5432
REDIS_PORT=6379

# Service ports
BACKEND_PORT=8080
FRONTEND_PORT=3000

# Backend
SERVER_PORT=8080
SPRING_PROFILES_ACTIVE=dev
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/sangui_rag_gateway
SPRING_DATASOURCE_USERNAME=sangui
SPRING_DATASOURCE_PASSWORD=sangui_password
SPRING_DATA_REDIS_HOST=localhost
SPRING_DATA_REDIS_PORT=6379

# RAG gateway
# For local development, the default dev profile provides distinct non-production placeholders.
# For any deployment, replace both with strong secrets of at least 32 characters.
RAG_ADMIN_AUTH_JWT_SECRET=local-dev-admin-jwt-secret-change-me-32chars
RAG_GATEWAY_ENCRYPTION_SECRET_KEY=local-dev-aes-key-secret-change-me-32chars

# Default admin bootstrap (dev only; Docker Compose also defaults to admin/admin123 for local first use)
# Production must set allow-default-admin=true and a strong non-default password.
# RAG_ADMIN_AUTH_DEFAULT_ADMIN_USERNAME=admin
# RAG_ADMIN_AUTH_DEFAULT_ADMIN_PASSWORD=admin123
# RAG_ADMIN_AUTH_ALLOW_DEFAULT_ADMIN=false

# Deprecated: kept only for backward compatibility; the two variables above are the new canonical secrets.
# RAG_GATEWAY_SECRET_KEY is no longer read by AdminJwtService or UpstreamApiKeyEncryptor.
RAG_GATEWAY_SECRET_KEY=local-dev-hs256-secret-change-me-32chars
# Never use local-dev-change-me or short keys -- they fail HS256 and are rejected at startup.
# The documented placeholder below is also rejected at startup:
# RAG_GATEWAY_SECRET_KEY=<set-a-strong-32-char-secret>

# Storage
FILE_STORAGE_TYPE=local
FILE_STORAGE_LOCAL_PATH=./data/uploads
# Object storage (required when FILE_STORAGE_TYPE=object)
# FILE_STORAGE_OBJECT_ENDPOINT=http://localhost:9000
# FILE_STORAGE_OBJECT_BUCKET=rag-documents
# FILE_STORAGE_OBJECT_ACCESS_KEY=<set-object-access-key>
# FILE_STORAGE_OBJECT_SECRET_KEY=<set-object-secret-key>
# FILE_STORAGE_OBJECT_REGION=us-east-1
# FILE_STORAGE_OBJECT_PATH_STYLE_ACCESS=true

# Document processing
RAG_DOCUMENT_CHUNK_SIZE=800
RAG_DOCUMENT_CHUNK_OVERLAP=100
RAG_DOCUMENT_MAX_FILE_SIZE_BYTES=1048576

# Retrieval
RAG_RETRIEVAL_DEFAULT_TOP_K=5
RAG_RETRIEVAL_DEFAULT_SIMILARITY_THRESHOLD=0.300
RAG_RETRIEVAL_DEFAULT_MAX_CONTEXT_CHUNKS=5
RAG_RETRIEVAL_DEFAULT_MAX_CONTEXT_CHARS=12000
RAG_RETRIEVAL_DEFAULT_MAX_SINGLE_CHUNK_CHARS=3000

# Production guard acknowledgements (only needed in prod/production profiles)
RAG_PRODUCTION_ALLOW_LOCAL_FILE_STORAGE=false
RAG_PRODUCTION_ALLOW_OUTPUT_CAPTURE=false
# Allow weak local secret for dev/test only; never enable in production.
# Deprecated: the weak placeholder 'local-dev-change-me' is now always rejected at startup regardless of this flag.
RAG_PRODUCTION_ALLOW_WEAK_LOCAL_SECRET=false

# API key rate limits
RAG_API_KEY_LIMITS_ENABLED=true
RAG_API_KEY_LIMITS_DEFAULT_REQUESTS_PER_MINUTE=60
RAG_API_KEY_LIMITS_DEFAULT_TOKENS_PER_MINUTE=60000
RAG_API_KEY_LIMITS_DEFAULT_DAILY_REQUEST_QUOTA=1000
RAG_API_KEY_LIMITS_DEFAULT_DAILY_TOKEN_QUOTA=1000000
RAG_API_KEY_LIMITS_DEFAULT_COMPLETION_TOKEN_RESERVATION=1024
